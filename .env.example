# AdaptiveNet settings. Copy to .env (git ignores it) and fill in only what you need.
# Tests and the Docker demo need NOTHING here: demo/run.sh makes its own demo/.env.demo.
# See docs/ENV_SETUP.txt for the AWS SSO and RIPE Atlas steps.

# --- Optional local gateway lab (compose.yaml on its own) ---------------------------
LAB_TOKEN=replace-with-a-long-random-value
LOCAL_AUTO_MITIGATION=false

# --- Real AWS pipeline (scripts/live_monitor.py, ingestion.py, aws_fault.py) --------
# The AWS profile is chosen with --profile (default adaptivenet-admin), not here.
# AMP workspaces: the defaults in services/adaptivenet/ingestion/config.py are the
# group's; set these only for your own deployment.
# AMP_SG_WORKSPACE_ID=ws-your-singapore-workspace
# AMP_US_WORKSPACE_ID=ws-your-virginia-workspace

# SQS queue for --sqs mode (omit to look it up by the fixed queue name).
# ADAPTIVENET_SQS_QUEUE_URL=https://sqs.ap-southeast-1.amazonaws.com/YOUR_12_DIGIT_ACCOUNT/adaptivenet-dev-telemetry
# ADAPTIVENET_AWS_ACCOUNT_ID=YOUR_12_DIGIT_ACCOUNT

# CloudFront metrics and the HTTP witness target (after the cloudfront Terraform apply).
# CLOUDFRONT_DISTRIBUTION_ID=E1234567890ABC

# --- RIPE Atlas ----------------------------------------------------------------------
# Reading public results needs no key. Set the measurement IDs you want to follow:
# ATLAS_MEASUREMENTS=region-a=12345678,region-b=12345679
# Creating or stopping measurements needs your own key (never commit or paste it):
# ATLAS_API_KEY=your-ripe-atlas-key
