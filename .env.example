# Local settings only. Copy to .env, never commit your actual .env.
# Needed for the optional Docker lab; replace with a random value.
LAB_TOKEN=replace-with-a-long-random-value
LOCAL_AUTO_MITIGATION=false

# The ingestion config already has the current AWS workspace defaults.
# Override when deploying to different workspaces:
# AMP_SG_WORKSPACE_ID=ws-your-singapore-workspace
# AMP_US_WORKSPACE_ID=ws-your-virginia-workspace

# When you create/clone RIPE Atlas measurements, put their NEW IDs here:
# ATLAS_MEASUREMENTS=region-a=12345678,region-b=12345679

# Singapore SQS queue for --sqs mode (omit to discover by fixed queue name).
# ADAPTIVENET_SQS_QUEUE_URL=https://sqs.ap-southeast-1.amazonaws.com/ACCOUNT_ID/adaptivenet-dev-telemetry
# ADAPTIVENET_AWS_ACCOUNT_ID=YOUR_12_DIGIT_ACCOUNT

# Optional CloudFront metric ingestion after cloudfront Terraform apply.
# CLOUDFRONT_DISTRIBUTION_ID=E1234567890ABC
