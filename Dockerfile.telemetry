# Dedicated image for the real AWS/RIPE telemetry producer and SQS feature worker.
# The existing root Dockerfile and compose.yaml remain the separate local lab.
FROM python:3.12-slim
WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 HOME=/home/telemetry AWS_EC2_METADATA_DISABLED=true
COPY pyproject.toml requirements-runtime.lock ./
COPY services ./services
COPY scripts ./scripts
RUN pip install --no-cache-dir -r requirements-runtime.lock \
    && pip install --no-cache-dir --no-deps -e . \
    && pip install --no-cache-dir 'boto3>=1.35,<2' 'awscurl>=0.30,<1' 'awscli>=1.35,<2' \
    && mkdir -p /app/data /home/telemetry
CMD ["python", "scripts/sqs_ingestion.py", "consume-watch"]
